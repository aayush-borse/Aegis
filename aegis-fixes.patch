+def _execute_with_rate_limit_retry(
+    request: urllib.request.Request, timeout: float
+) -> dict:
+    """Execute an OSV HTTP request, retrying transient HTTP 429 responses.
+
+    Retries up to ``len(_RATE_LIMIT_BACKOFF_SECONDS)`` times on HTTP 429
+    only, sleeping for the corresponding backoff duration between attempts.
+    Other HTTP errors, network errors, timeouts, and parse errors are
+    surfaced immediately as :class:`OSVError` without retry.
+    """
+    max_retries = len(_RATE_LIMIT_BACKOFF_SECONDS)
+    last_rate_limit_error: OSVError | None = None
+
+    for attempt in range(max_retries + 1):
+        try:
+            with urllib.request.urlopen(request, timeout=timeout) as response:
+                return json.loads(response.read().decode("utf-8"))
+        except urllib.error.HTTPError as exc:
+            if exc.code == 429:
+                last_rate_limit_error = OSVError(
+                    "Rate limit exceeded (HTTP 429) while querying OSV.dev."
+                )
+                if attempt < max_retries:
+                    time.sleep(_RATE_LIMIT_BACKOFF_SECONDS[attempt])
+                    continue
+                raise last_rate_limit_error from exc
+            raise OSVError(f"HTTP error {exc.code}: {exc.reason}") from exc
+        except urllib.error.URLError as exc:
+            raise OSVError(f"Network error: {exc.reason}") from exc
+        except TimeoutError as exc:
+            raise OSVError(f"Request timed out after {timeout} seconds.") from exc
+        except (OSError, json.JSONDecodeError) as exc:
+            raise OSVError(f"Invalid response or system error: {exc}") from exc
+
+    # Defensive fallback: loop exited without returning or raising. Should
+    # be unreachable because the final 429 attempt raises above, but keep
+    # the explicit error to satisfy type checkers and guard against future
+    # edits to the retry policy.
+    raise last_rate_limit_error or OSVError(
+        "Rate limit exceeded (HTTP 429) while querying OSV.dev."
+    )
+
